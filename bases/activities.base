# Maintained view; content scope follows docs/metadata.md.
filters:
  and:
    - 'file.ext == "md" && !file.path.contains("/attachments/") && (file.path == "home.md" || file.path == "maintenance.md" || file.inFolder("inbox") || file.inFolder("knowledge") || file.inFolder("activities") || file.inFolder("domains") || file.inFolder("sources") || file.inFolder("journals"))'
    - 'kind == "activity"'
views:
  - type: table
    name: "Current"
    filters: 'status == "active"'
    order:
      - file.name
      - domains
      - file.mtime
  - type: table
    name: "Future and paused"
    filters: 'status == "planned" || status == "paused"'
    order:
      - file.name
      - status
      - domains
  - type: table
    name: "History"
    filters: 'status == "completed" || status == "abandoned"'
    order:
      - file.name
      - status
      - domains
