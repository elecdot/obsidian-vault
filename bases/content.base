# Maintained view; content scope follows docs/metadata.md.
filters:
  and:
    - 'file.ext == "md" && !file.path.contains("/attachments/") && (file.path == "home.md" || file.path == "maintenance.md" || file.inFolder("inbox") || file.inFolder("knowledge") || file.inFolder("activities") || file.inFolder("domains") || file.inFolder("sources") || file.inFolder("journals"))'
views:
  - type: table
    name: "Recent writing"
    sort:
      - property: file.mtime
        direction: DESC
    limit: 50
    filters: 'kind == "note"'
    order:
      - file.name
      - domains
      - activities
      - sources
      - file.mtime
  - type: table
    name: "All content"
    order:
      - file.name
      - kind
      - format
      - status
      - file.mtime
