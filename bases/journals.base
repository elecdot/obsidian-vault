filters:
  and:
    - file.ext == "md" && !file.path.contains("/attachments/") && (file.path == "home.md" || file.path == "maintenance.md" || file.inFolder("inbox") || file.inFolder("knowledge") || file.inFolder("activities") || file.inFolder("domains") || file.inFolder("sources") || file.inFolder("journals"))
    - format == "journal" || format == "review"
formulas:
  title: link(file.path, if(aliases && list(aliases).length > 0, list(aliases)[0], file.name))
properties:
  formula.title:
    displayName: Note
views:
  - type: table
    name: Periods
    order:
      - formula.title
      - date
      - period
      - format
    sort:
      - property: date
        direction: DESC
